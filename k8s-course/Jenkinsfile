```groovy
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo "Repository checked out by Jenkins"
            }
        }

        stage('Environment Setup') {
            steps {
                dir('k8s-course/ci-demo') {
                    sh '''
                        python3 --version
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('k8s-course/ci-demo') {
                    sh '''
                        mkdir -p reports
                        .venv/bin/python -m pytest \
                            tests \
                            --junitxml=reports/results.xml \
                            -v
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ci-demo:${BUILD_NUMBER} \
                        ./k8s-course/ci-demo

                    docker images ci-demo
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        IMAGE="${DOCKERHUB_USER}/ci-demo:${BUILD_NUMBER}"

                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'docker logout >/dev/null 2>&1 || true; rm -rf "$DOCKER_CONFIG"' EXIT

                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker tag "ci-demo:${BUILD_NUMBER}" "$IMAGE"

                        docker push "$IMAGE"

                        echo "Successfully pushed: $IMAGE"
                    '''
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'k8s-course/ci-demo/reports/*.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'All CI stages completed successfully!'
        }

        failure {
            echo 'CI pipeline failed. Check Console Output.'
        }
    }
}
```