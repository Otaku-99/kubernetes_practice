
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo "Repository checked out by Jenkins"
            }
        }

        stage('Environment Setup') {
            steps {
                dir('k8s-course/ci-demo') {
                    sh '''
                        python3 --version
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('k8s-course/ci-demo') {
                    sh '''
                        mkdir -p reports
                        .venv/bin/python -m pytest \
                            tests \
                            --junitxml=reports/results.xml \
                            -v
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ci-demo:${BUILD_NUMBER} \
                        ./k8s-course/ci-demo

                    docker images ci-demo
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        case "$DOCKERHUB_USER" in
                            ''|[!a-z0-9]*|*[!a-z0-9._-]*)
                                echo >&2 "Invalid Docker Hub username in Jenkins credential 'dockerhub-creds'. Set its username field to the Docker Hub namespace only, without docker login commands or flags."
                                exit 1
                                ;;
                        esac

                        IMAGE="${DOCKERHUB_USER}/ci-demo:${BUILD_NUMBER}"
                        docker tag "ci-demo:${BUILD_NUMBER}" "$IMAGE"
                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'docker logout >/dev/null 2>&1 || true; rm -rf "$DOCKER_CONFIG"' EXIT

                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$IMAGE"
                    '''
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubernetes-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="otakugamie/ci-demo:${BUILD_NUMBER}"

                        echo "Deploying image: $IMAGE"

                        kubectl set image deployment/ci-demo \
                            ci-demo="$IMAGE" \
                            -n default

                        echo "Waiting for rollout..."

                        if ! kubectl rollout status deployment/ci-demo \
                            -n default --timeout=180s; then

                            echo "Deployment failed. Rolling back..."

                            kubectl rollout undo deployment/ci-demo \
                                -n default

                            kubectl rollout status deployment/ci-demo \
                                -n default --timeout=120s || true

                            exit 1
                        fi

                        echo "Deployment completed successfully!"

                        kubectl get pods -l app=ci-demo -n default
                        kubectl get deployment ci-demo -n default
                    '''
                }
            }
        }

    }

    post {
        always {
            junit testResults: 'k8s-course/ci-demo/reports/*.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'All CI stages completed successfully!'
        }

        failure {
            echo 'CI pipeline failed. Check Console Output.'
        }
    }
}
