
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo "Repository checked out by Jenkins"
            }
        }

        stage('Environment Setup') {
            steps {
                sh '''
                    python3 --version
                    python3 -m venv k8s-course/ci-demo/.venv
                    k8s-course/ci-demo/.venv/bin/python -m pip install --upgrade pip
                    k8s-course/ci-demo/.venv/bin/python -m pip install -r k8s-course/ci-demo/requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    mkdir -p k8s-course/ci-demo/reports
                    k8s-course/ci-demo/.venv/bin/python -m pytest \
                        k8s-course/ci-demo/tests \
                        --junitxml=k8s-course/ci-demo/reports/results.xml \
                        -v
                '''
            }
        }
    }

    post {
        always {
            junit testResults: 'k8s-course/ci-demo/reports/*.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'All CI stages completed successfully!'
        }

        failure {
            echo 'CI pipeline failed. Check Console Output.'
        }
    }
}
